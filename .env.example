# Copy this file to ".env" and fill it in. ".env" must NEVER go to GitHub.
# On Vercel, add the same variables under Settings > Environment Variables
# (except DISCORD_BOT_TOKEN, which is only used on your computer).

# Required: a long random string. It signs the presenter links.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LETSWATCH_SECRET=

# Password for the /admin page (end any live). Use a long password.
# If empty, the admin page is disabled.
ADMIN_PASSWORD=

# Discord (Developer Portal > your application)
# General Information > Application ID and Public Key
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Bot > Reset Token (only used on your computer, to register /live)
DISCORD_BOT_TOKEN=

# Optional: fixed site address (e.g. https://lets-watch.vercel.app).
# If empty, the address is detected automatically.
PUBLIC_URL=

# TURN server: relays the video when the network blocks the direct connection (see the README).
# If everything is empty, the site automatically uses the free public Open Relay TURN.
# To use another one, configure only ONE of the options below.
# Option 1: Cloudflare, 1,000 GB free per month (requires a card)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Option 2: Metered with your own account (paste the whole URL with ?apiKey=...)
METERED_TURN_URL=
# Option 3: any TURN with a fixed username and password (e.g. ExpressTURN)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Extra accounts (e.g. friends' free ExpressTURN accounts), up to _5.
# The browser tries all of them: if one runs out of quota, the others keep working.
# On Vercel, only add the ones you use (empty values are not accepted).
TURN_URL_2=
TURN_USERNAME_2=
TURN_CREDENTIAL_2=
# To turn off the automatic Open Relay fallback: TURN_OPENRELAY=false
TURN_OPENRELAY=

# Optional: your own PeerJS server. Empty = the free public PeerJS server.
PEER_HOST=
PEER_PORT=
PEER_PATH=
PEER_SECURE=
