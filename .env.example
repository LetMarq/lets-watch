# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Obrigatório: um texto aleatório e longo. Ele assina os links de apresentador.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LETSWATCH_SECRET=

# Senha da página /admin (encerrar qualquer live). Use uma senha longa.
# Se ficar vazia, a página de admin fica desativada.
ADMIN_PASSWORD=

# Discord (Developer Portal > sua aplicação)
# General Information > Application ID e Public Key
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Bot > Reset Token (só é usado no seu computador, para registrar o /live)
DISCORD_BOT_TOKEN=

# Opcional: endereço fixo do site (ex.: https://letswatch.vercel.app).
# Se ficar vazio, o endereço é descoberto automaticamente.
PUBLIC_URL=

# Servidor TURN: repassa o vídeo quando a rede bloqueia a conexão direta (veja o README).
# Se deixar tudo vazio, o site usa sozinho o TURN público e gratuito do Open Relay.
# Para usar outro, configure só UMA das opções abaixo.
# Opção 1: Cloudflare, 1.000 GB grátis por mês (pede cartão)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Opção 2: Metered / Open Relay, 20 GB grátis por mês (cole a URL inteira com ?apiKey=...)
METERED_TURN_URL=
# Opção 3: qualquer outro TURN com usuário e senha fixos (ex.: ExpressTURN)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Para desligar o Open Relay automático: TURN_OPENRELAY=false
TURN_OPENRELAY=

# Opcional: servidor PeerJS próprio. Vazio = servidor gratuito público do PeerJS.
PEER_HOST=
PEER_PORT=
PEER_PATH=
PEER_SECURE=
